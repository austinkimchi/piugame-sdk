{
  "name": "@austinkimchi/piugame-sdk",
  "version": "1.3.1",
  "description": "Pump It Up PHOENIX (ANDAMIRO) TypeScript SDK. Supports session auth and play-data scraping.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "tests": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/login.integration.test.ts",
    "profile:login": "node --env-file=.env scripts/profile-login.js",
    "profile:title": "node scripts/profile-title.js",
    "scrape:png": "node --env-file=.env scripts/scrape-png.js",
    "scrape:png:dry": "node scripts/scrape-png.js --dry-run",
    "seed:song-catalog": "node --env-file=.env scripts/seed-song-catalog.js",
    "seed:series-reference": "node --env-file=.env scripts/seed-series-reference.js",
    "assign:song-series": "node --env-file=.env scripts/assign-song-series.js",
    "review:song-series-ui": "node --env-file=.env scripts/series-review-ui-server.js",
    "collect:media": "node --env-file=.env scripts/media-collector.js",
    "collect:media:audio": "node --env-file=.env scripts/media-collector.js --phase=audio",
    "collect:media:youtube-index": "node --env-file=.env scripts/media-collector.js --phase=youtube-index",
    "collect:media:youtube": "node --env-file=.env scripts/media-collector.js --phase=youtube",
    "collect:media:youtube-backfill": "node --env-file=.env scripts/media-collector.js --phase=youtube-backfill",
    "collect:media:youtube-reconcile": "node --env-file=.env scripts/media-collector.js --phase=youtube-reconcile",
    "review:media-ui": "node --env-file=.env scripts/media-review-ui-server.js"
  },
  "keywords": [
    "piugame",
    "sdk",
    "typescript",
    "php-session",
    "scraper"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "cheerio": "1.0.0",
    "mongodb": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.1",
    "dotenv": "^16.5.0",
    "playwright": "^1.54.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "private": false,
  "allowScripts": {
    "esbuild@0.27.2": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
